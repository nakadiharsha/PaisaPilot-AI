# ========================================================
# PaisaPilot AI – Environment Configuration
# ========================================================

# Server Port (default: 5000)
PORT=5000

# SQLite Database File Path (defaults to ./server/paisapilot.db)
DB_PATH=./server/paisapilot.db

# Gemini API Key (Optional)
# If provided, enables live multimodal reasoning and autonomous planning with Gemini 2.5 Flash.
# If omitted or invalid, PaisaPilot operates in 100% deterministic demo mode,
# executing all 16 MCP tools with natural language understanding without requiring paid APIs.
GEMINI_API_KEY=

# Gemini Model Name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Node Environment
NODE_ENV=development
